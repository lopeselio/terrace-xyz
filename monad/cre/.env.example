# Copy to cre/.env (gitignored). Never commit the real file.
# Key that pays for --broadcast writes (the deployer), or a 1Password reference (op://vault/item/field).
CRE_ETH_PRIVATE_KEY=
# Signs simulated reports so TerraceOracle trusts the mock forwarder path.
CRE_SECRET_SIM_ATTESTOR_PRIVATE_KEY=
# API-Football key from dashboard.api-football.com (or anything the replay server accepts)
CRE_SECRET_RESULTS_API_KEY=
# AI answers for custom questions: set one or both, pick with "aiProvider" in questions/config.
CRE_SECRET_GEMINI_API_KEY=
CRE_SECRET_ANTHROPIC_API_KEY=
# X25519 private key that opens sealed picks and bets; the app gets its public key.
CRE_SECRET_REVEAL_PRIVATE_KEY=
# Alchemy Monad testnet key (bare key, not the URL); used by project.yaml and our servers.
ALCHEMY_API_KEY=
