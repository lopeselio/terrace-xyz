# Public
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# X25519 public key of the CRE reveal workflow (cre: bun run keys)
NEXT_PUBLIC_REVEAL_PUBLIC_KEY=
# Passkey relying party: the site's host name (defaults to the current host)
NEXT_PUBLIC_RP_ID=

# Server only
# Onboarding treasury: tops up new players with MON for gas, test dollars and USDC
ONBOARDING_PRIVATE_KEY=
# Alchemy Monad testnet key (servers use Alchemy; browsers use the public RPC)
ALCHEMY_API_KEY=
# API-Football key (team and player names for matches, live minute)
API_FOOTBALL_KEY=
# Take compiler: "gemini" (default) or "anthropic"
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Envio GraphQL endpoint (local: http://localhost:8080/v1/graphql)
INDEXER_URL=http://localhost:8080/v1/graphql

# Azure Table Storage for reactions and streak repairs (az storage account show-connection-string)
AZURE_TABLES_CONNECTION=

# Telegram group bot (bot/): its public URL, the same as the bot's BOT_PUBLIC_URL. The /link/telegram page
# only ever posts to this URL, and stays off while it's empty.
NEXT_PUBLIC_TELEGRAM_BOT_URL=
# Privy Telegram login inside the Mini App (needs Telegram set up in the Privy dashboard first). "1" to turn on.
NEXT_PUBLIC_TELEGRAM_SIGNIN=
