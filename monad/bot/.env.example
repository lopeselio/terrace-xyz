# BotFather token for the bot (never commit the real one)
TELEGRAM_BOT_TOKEN=
# Random string Telegram echoes back on every webhook call (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET=
# Public https base URL of this server (webhook lands on $BOT_PUBLIC_URL/telegram, deep links go through $BOT_PUBLIC_URL/go/...)
BOT_PUBLIC_URL=
PORT=8787
# Terrace app (compile-take, matches, indexer proxy)
TERRACE_URL=https://play.terrace.social
BOT_DB=./bot.sqlite
# Time zone for kickoff and lock times in group messages
BOT_TZ=Europe/London
# Optional: API-Football key for goal/card events (scores still flow without it, from Terrace's match list)
API_FOOTBALL_KEY=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
BOT_DEFAULT_STAKE=5
