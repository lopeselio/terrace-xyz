{
  "name": "terrace-mm-plugin",
  "version": "0.1.0",
  "description": "Terrace for the MetaMask Agent Wallet (mm): find football takes, back or fade them, post your own as markets, take 1v1 challenges and auto-collect winnings on Monad.",
  "keywords": ["oclif-plugin", "metamask", "agent-wallet", "monad", "prediction-markets", "football"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopeselio/terrace-xyz.git",
    "directory": "monad/mm-plugin"
  },
  "homepage": "https://play.terrace.social",
  "type": "module",
  "engines": { "node": ">=20.10.0" },
  "files": ["dist", "skills", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "terrace": { "description": "Terrace football prediction markets on Monad: takes, bets, 1v1s and payouts" }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": ">=6.2.0",
    "capabilities": [],
    "commands": [
      { "id": "terrace:matches", "capabilities": [], "dataAccess": [] },
      { "id": "terrace:takes", "capabilities": [], "dataAccess": [] },
      { "id": "terrace:value", "capabilities": [], "dataAccess": [] },
      { "id": "terrace:positions", "capabilities": ["wallet-read"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "terrace:back", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] },
      { "id": "terrace:take", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] },
      { "id": "terrace:accept", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts", "balances"], "targetChains": [10143] },
      { "id": "terrace:collect", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "terrace:register", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] },
      { "id": "terrace:faucet", "capabilities": ["wallet-read", "wallet-submit"], "dataAccess": ["accounts"], "targetChains": [10143] }
    ]
  },
  "peerDependencies": { "@metamask/agent-wallet": ">=6.2.0" },
  "dependencies": { "viem": "^2.37.0" },
  "devDependencies": {
    "@metamask/agent-wallet": "7.1.0",
    "@oclif/core": "4.14.0",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
