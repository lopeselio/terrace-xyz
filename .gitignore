node_modules/
.turbo/
dist/
build/
.next/

# Cloudflare Workers
.wrangler/
.dev.vars

# Anchor / Rust
target/
**/*.rs.bk
.anchor/
test-ledger/

# Arcium localnet runtime artifacts (autogenerated by `arcium init-mxe` / `arcium localnet`):
# program binaries, node configs, identity keys, MPC private shares, etc.
packages/programs/artifacts/
packages/programs/Anchor.toml.bak

# Solana keypairs — never commit
*.json
!package.json
!package-lock.json
!tsconfig*.json
!turbo.json

# Environment — every variant, so a new .env.mainnet can't slip through on the
# day someone creates it. .env.example is the one that ships.
.env
.env.*
!.env.example

# Agent session transcripts. Full conversation logs: they quote whatever was on
# screen, which has included .env contents and pasted keys. Kept locally for
# grant proof-of-work, never committed. The *.json rule above misses .jsonl.
*.jsonl
claude-session*
codex-session*

# React Native
.expo/
packages/app/android/
packages/app/ios/
packages/app/.gradle/
*.jks
*.keystore

# Misc
.DS_Store
*.log
.claude/

# Local agent skills and project scaffolding context (dev tooling, not source)
.agents/
.superstack/

# house liquidity agent's local spend tracker
monad/agents/.house-state.json
