
HELIUS_API_KEY=your_helius_api_key_here
EXPO_PUBLIC_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Jupiter Prediction Market API — get key at https://portal.jup.ag
EXPO_PUBLIC_JUPITER_API_KEY=your_jupiter_api_key_here

# USDC devnet mint
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Program ID (update after anchor deploy)
TERRACE_PROGRAM_ID=11111111111111111111111111111111
EXPO_PUBLIC_TERRACE_PROGRAM_ID=11111111111111111111111111111111

# Privy embedded wallets — get App ID at https://dashboard.privy.io
# Leave blank to disable Privy and use MWA-only mode
EXPO_PUBLIC_PRIVY_APP_ID=

# Telegram bot — get token from @BotFather at https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
JUPITER_API_KEY=your_jupiter_api_key_here
TERRACE_APP_DEEP_LINK=https://terrace.app

# Google Gemini API — used for AI match insights in MatchGroupCard
# Get a free key at https://aistudio.google.com/apikey (no paid plan needed)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# API-Football (api-sports.io) — live fixtures, scores and the matchday board.
#
# Preferred: proxy through the notifications worker, which holds one key
# server-side and caches responses for every device. Set the worker's /football
# route here and leave the device key blank.
#   wrangler secret put API_FOOTBALL_KEY   (in packages/notifications-worker)
EXPO_PUBLIC_FOOTBALL_PROXY_URL=https://terrace-notifications.workers.dev/football
#
# Fallback: a key on the device. Free tier is 100 requests/day *per key*, and
# every install spends from the same allowance — fine for local work, not for a
# cohort. Ignored when the proxy URL above is set. Leave both blank to disable
# live scores entirely (the rest of every card still renders).
EXPO_PUBLIC_API_FOOTBALL_KEY=your_api_football_key_here
